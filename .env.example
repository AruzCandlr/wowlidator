# wowlidator — LLM routing and runtime configuration.
# Copy to .env and fill in whichever providers you actually use.
# Verify everything resolves with:  wowlidator doctor

# ---------------------------------------------------------------------------
# Provider keys. You only need a key for the providers your roles point at.
# A run with --no-heal, --no-agent and no `generate` needs no keys at all.
# ---------------------------------------------------------------------------

# Google AI Studio — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Groq — https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# EmmieDev — https://chat.emmiedev.com (OpenAI-compatible, keys start `ek-`;
# the server ignores the model field, so no WOWLIDATOR_<ROLE>_MODEL is needed)
EMMIEDEV_API_KEY=

# Z.AI (Zhipu GLM) — https://z.ai/manage-apikey/apikey-list
# OpenAI-compatible; model ids like `glm-4.6`, `glm-4.5-air`
ZAI_API_KEY=

# DeepSeek — https://platform.deepseek.com/api_keys
# OpenAI-compatible; model ids `deepseek-chat` (V3) and `deepseek-reasoner` (R1)
DEEPSEEK_API_KEY=

# Local model — an OpenAI-compatible server on this machine (mlx_lm.server,
# llama.cpp, vLLM, LM Studio). No key needed; set one only if your server
# demands it. Point any role at it: WOWLIDATOR_HEALER_PROVIDER=local
# The server answers with the model it loaded, so there is no model to name:
# WOWLIDATOR_<ROLE>_MODEL is ignored for this provider (same as emmiedev).
# Catalog rows are authored one at a time on it (it answers one call at a time);
# --author-concurrency overrides.
LOCAL_LLM_BASE_URL=http://localhost:8080/v1
LOCAL_LLM_API_KEY=
# One role can use a different local server (a second rerise on another port):
# WOWLIDATOR_<ROLE>_BASE_URL overrides LOCAL_LLM_BASE_URL for that role only.
# The panel's port field next to a role set to "local" writes this line.
# WOWLIDATOR_GENERATOR_BASE_URL=http://localhost:8081/v1
# How long one local call may take before the client gives up (ms). A 20k-token
# authoring prompt takes 1–5 minutes on a laptop; Node's default is 300 s.
# LOCAL_LLM_TIMEOUT_MS=900000

# Google AI Studio meters per minute and per day, per model, and publishes no
# endpoint to ask a key's limits. wowlidator paces itself from the documented
# free-tier table (src/providers/rate-pacer.ts), refined by what each 429 body
# states, and waits before crossing 90% of a limit. Your tier, if it differs:
# WOWLIDATOR_GOOGLE_RPM=10
# WOWLIDATOR_GOOGLE_TPM=250000
# WOWLIDATOR_GOOGLE_RPD=250
# Day counts persist in .wowlidator/llm-usage.json (key tail + model, no key).

# Every model request and response is logged to stderr: who asked (role · task),
# model, tokens, pacing state, the first line of the ask, the object returned.
# WOWLIDATOR_LLM_LOG=on        # on (default) | full (untruncated responses) | off
# WOWLIDATOR_LLM_LOG_CHARS=1500

# ---------------------------------------------------------------------------
# Role routing. Any role can point at any provider; these are the defaults.
#
#   healer     repairs a dead selector    small, fast, latency-sensitive
#   generator  writes tests from a page   largest prompt in the system
#   agent      crosses unknown pages      one decision per turn
#   data       regenerates conflicting    small, rare — most data generation
#              form data on a fillRetry   never reaches a model at all
#
# ⚠️ Model ids drift. Run `wowlidator doctor` to confirm each one still resolves.
# ---------------------------------------------------------------------------

# WOWLIDATOR_HEALER_PROVIDER=groq
# WOWLIDATOR_HEALER_MODEL=openai/gpt-oss-120b

# WOWLIDATOR_GENERATOR_PROVIDER=google
# WOWLIDATOR_GENERATOR_MODEL=gemini-3-flash

# WOWLIDATOR_AGENT_PROVIDER=groq
# WOWLIDATOR_AGENT_MODEL=openai/gpt-oss-120b

# WOWLIDATOR_DATA_PROVIDER=groq
# WOWLIDATOR_DATA_MODEL=openai/gpt-oss-120b

# Retries per model call. Free tiers rate-limit hard; the SDK backs off.
# WOWLIDATOR_LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# WOWLIDATOR_CDP_URL=http://localhost:9222
# WOWLIDATOR_CACHE_PATH=healed-selectors.json
# WOWLIDATOR_PROOF_DIR=.wowlidator/proofs
# WOWLIDATOR_REPORT_DIR=.wowlidator/reports
# WOWLIDATOR_REPORT_PATH=artifacts/{date}/{name}.html   # file, dir, or {placeholder} template
# WOWLIDATOR_DISABLE_REPORT=1              # skip HTML report generation
# Film the run, with a pointer drawn into the page so clicks are visible. A
# still cannot show a click, only the page on either side of one. The recording
# is embedded in the report and every step can be played from.
#
# Recording needs a browser context wowlidator creates, so a filmed run does
# NOT inherit the attached browser's cookies — set this to off for a run that
# depends on a session someone signed into by hand.
# WOWLIDATOR_VIDEO=on                      # on (default) | off
# Stills. `auto` follows the recording: failures only while filming, since the
# video already carries every other step, and every step when filming is off —
# where the frame before a failure is usually where the wrong thing happened
# and cannot be recovered afterwards. Set a mode explicitly to have both.
# WOWLIDATOR_SCREENSHOTS=auto              # auto (default) | all | on-event | on-failure | off
# Settle before each capture. A navigation waits for domcontentloaded, which
# fires before a client-rendered app has drawn anything — capture on that event
# and the filmstrip is a reel of empty shells for steps that passed. Raise it
# for a slow or heavily animated app; 0 captures as early as the load states
# allow.
# WOWLIDATOR_CAPTURE_DELAY_MS=250           # milliseconds, 0–30000
# WOWLIDATOR_VIEWPORT=1920x1080           # page size for runs and captures; `off` keeps the window's own size
# WOWLIDATOR_DISABLE_HEALING=1             # run execution-plane only
# WOWLIDATOR_DISABLE_AGENT=1               # make `workflow` steps fail instead of navigating
# Let the agent rescue a control the healer cannot find — one that is behind a
# closed menu, below the fold, or on a view still loading. It drives the browser
# until the control is reachable, then YOUR selector is retried against the page
# it opened up; the step still has to resolve on its own terms, and an assertion
# is never offered this. Off by default because it changes the application
# before the step runs.
# WOWLIDATOR_AGENT_ASSIST=1                 # same as --agent-assist
# Keep the browser out of your way. Set this and no window ever appears — a
# browser wowlidator already has open is restarted without one, so it takes
# effect on the second run of the day as well as the first. Screenshots, the
# accessibility tree and the filmstrip are all unaffected. --no-headless on a
# single command overrides it when you want to watch a run.
# WOWLIDATOR_HEADLESS=1
# Renderer sandbox off. Containers only — Chrome runs headless perfectly well
# sandboxed on a desktop, and this browser loads the application under test.
# WOWLIDATOR_CHROME_NO_SANDBOX=1

# --- Database verification (docs/db-verification-spec.md) --------------------
# Read-only connection for the DB verification steps (expectDbRow, dbSnapshot,
# expectDbDelta, expectDbUnchanged, expectDbCalled) and for schema
# introspection when `context build` finds no schema file. The driver is a
# lazy optional import — install it where verification is wanted:
#   npm install pg
# WOWLIDATOR_DB_URL=postgres://wowlidator_ro:password@localhost:5432/app
# A DSN resolving to a non-loopback host is refused without this opt-in:
# WOWLIDATOR_DB_REMOTE_OK=1
